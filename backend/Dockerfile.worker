FROM python:3.12-slim
WORKDIR /app/backend

# Microsoft ODBC Driver 18 for Azure SQL
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl gnupg apt-transport-https ca-certificates \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
      | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
      > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
COPY data/ /app/data/
COPY Assignment_02_Pack/ /app/Assignment_02_Pack/
RUN mkdir -p /app/data/invoice_uploads
ENV DATABASE_URL=sqlite:////app/data/band_a.db
ENV WORKER_AUTOSTART=false
ENV ALWAYS_QUEUE=true
CMD ["python", "-m", "app.band_b.worker"]
