# Backend
DATABASE_URL=sqlite:///../data/band_a.db
JWT_SECRET=local-dev-jwt-secret-change-in-production
JWT_AUDIENCE=band-a-local
JWT_EXPIRY_MINUTES=1440
ZOHO_WEBHOOK_SECRET=local-zoho-hmac-secret

# Tenant run quotas (active runs)
TENANT_QUOTA_COMPANY_A=100
TENANT_QUOTA_COMPANY_B=50

# Queue — always durable handoff (Plan 3A)
ALWAYS_QUEUE=true
QUEUE_BACKEND=sqlite
QUEUE_NAME=sales-lead-qualification
INVOICE_QUEUE_NAME=invoice-review
QUEUE_MAX_RETRIES=3
# SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=asl-invoice-sb.servicebus.windows.net

# Documents — local | blob
DOCUMENT_STORE_BACKEND=local
# AZURE_STORAGE_ACCOUNT=
# AZURE_BLOB_CONTAINER=documents

WORKER_AUTOSTART=false
# Band B model runtime: maf (Microsoft Agent Framework) | responses (Foundry Responses fallback)
AGENT_RUNTIME=maf

# Scheduler
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_ENABLED=false

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Zoho Mail bridge (webhook folder on Desktop → Band A)
MAIL_BRIDGE_KEY=local-mail-bridge-key
MAIL_TENANT_ID=company-a
MAIL_MONITOR_ADDRESS=aditya.chowdhury@giantleapsystems.com

# Microsoft Teams bot bridge (webhook folder → Band A)
TEAMS_BRIDGE_KEY=local-teams-bridge-key
TEAMS_TENANT_ID=company-a
